# Local Linux/amd64 compatibility experiment; not Engine's generated image.
FROM ghcr.io/astral-sh/uv:0.11.21@sha256:ff07b86af50d4d9391d9daf4ff89ce427bc544f9aae87057e69a1cc0aa369946 AS uv
FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY . /app
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy
RUN uv python find && uv sync --frozen --no-dev
CMD ["/app/.venv/bin/python", "-c", "import platform; from openai_engine_adapter.invoice import app; print(platform.python_version(), platform.machine(), app.name)"]
