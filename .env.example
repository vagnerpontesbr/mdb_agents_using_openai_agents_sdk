# Copy to .env and fill locally. Never commit .env or paste secrets into chat.
# The probe CLI reads exported variables; uv can load this with --env-file .env.
OPENAI_API_KEY=
OPENAI_MODEL=
VOYAGE_API_KEY=

# Legacy compatibility probes only. Application and Engine memory use separate clusters.
MONGODB_URI=
# SRV hostname only, without scheme/credentials/path; proves expected attachment.
ATLAS_CLUSTER_HOST=

# Planned MEM-002 destination only. Empty until the operator fills it privately.
# These local names are not consumed by the application or automatically applied to Engine.
# Do not replace APP_MONGODB_URI or the current MONGODB_URI during planning.
MYMEMORY_MONGODB_URI=
MYMEMORY_CLUSTER_HOST=
MYMEMORY_ATLAS_PROJECT_ID=

# Legacy compatibility probe variables. Current application targets are fixed in the adapter.
AGENT_ENGINE_URL=
AGENT_ENGINE_PROJECT_ID=
# Administrative workspace selection; memory remains project-scoped.
AGENT_ENGINE_WORKSPACE_ID=
AGENT_ENGINE_SERVICE_ACCOUNT_TOKEN=

# Keep live probes disabled until explicitly requested on the command line.
# This file alone never triggers model calls, index creation, or database writes.
VOYAGE_BASE_URL=https://ai.mongodb.com/v1

# Demo identity bootstrap: use only the OpenAI-SDK application cluster.
APP_MONGODB_URI=
APP_MONGODB_HOST=openai-sdk.qrmdk.mongodb.net
# Initial admin password is entered interactively, never stored here.

# Phase 1 application. Serve the built React app from this loopback origin.
# APP_MONGODB_HOST must be openai-sdk.qrmdk.mongodb.net (blank is not accepted).
APP_ORIGIN=http://127.0.0.1:8000
APP_WEB_DIST=apps/web/dist

# Current demo application features. Enable after the corresponding hosted setup.
APP_JOURNEY_ENABLED=false
# Enable only after verifying the deployed telecom-turn-v2 carrier and recovery contract.
APP_JOURNEY_LOCALE_ENABLED=false
APP_KNOWLEDGE_ENABLED=false
# Journey uses the operator's private ~/.agentengine/auth.json in the backend.
# OPENAI_API_KEY above enables voice; no credential belongs in the frontend.

# Knowledge domain identities, each restricted to its approved collections.
INGESTION_MONGODB_URI=
KNOWLEDGE_PUBLISHER_URI=
KNOWLEDGE_READER_URI=
# Optional calibrated candidate cache; omission falls back to fresh retrieval.
KNOWLEDGE_CACHE_URI=
# Offline evaluation only; never bind this identity to the hosted application.
EVALUATION_MONGODB_URI=
